// ==================== SAVE MEDIA FILE URL ====================
// Child app uploads to ImageKit directly, then calls this endpoint to save the URL to DB
router.post('/media', (req, res) => {
  try {
    const { token, file_url, file_type, command_source } = req.body;
    if (!token || !file_url) return res.status(400).json({ error: 'token and file_url required' });

    let fileType = file_type || 'other';
    const cmdSrc = command_source || '';

    db.prepare(`
      INSERT INTO media_files (token, file_url, file_type, command_source)
      VALUES (?, ?, ?, ?)
    `).run(token, file_url, fileType, cmdSrc || null);

    res.json({ success: true, file_url });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

