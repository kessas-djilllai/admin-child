router.get('/devices', (req, res) => {
  try {
    const devices = db.prepare('SELECT * FROM devices ORDER BY last_updated DESC').all();
    const cd = req.app.get('connectedDevices');
    const io = req.app.get('io');
    const result = devices.map(d => {
      const entry = cd ? cd[d.token] : null;
      const isOnline = !!(entry && io && io.sockets.sockets.has(entry.socketId));
      return { ...d, isOnline };
    });
    res.json(result);
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

