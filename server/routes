router.post('/commands', (req, res) => {
  try {
    const { id, device_token, command, params, timestamp, status } = req.body;
    const cmdId = id || uuidv4();
    const ts = timestamp || Date.now();

    const connectedDevices = req.app.get('connectedDevices');
    const io = req.app.get('io');
    const deviceEntry = connectedDevices ? connectedDevices[device_token] : null;

    const isSocketAlive = deviceEntry && io && io.sockets.sockets.has(deviceEntry.socketId);

    if (!isSocketAlive) {
      if (deviceEntry) {
        delete connectedDevices[device_token];
      }
      db.prepare(`
        INSERT INTO commands (id, device_token, command, params, status, timestamp)
        VALUES (?, ?, ?, ?, 'failed', ?)
        ON CONFLICT(id) DO UPDATE SET status = 'failed'
      `).run(cmdId, device_token, command, params || null, ts);
      res.json([{ id: cmdId, success: false, delivered: false, error: 'device_offline' }]);
      return;
    }

    db.prepare(`
      INSERT INTO commands (id, device_token, command, params, status, timestamp)
      VALUES (?, ?, ?, ?, 'pending', ?)
      ON CONFLICT(id) DO UPDATE SET status = excluded.status
    `).run(cmdId, device_token, command, params || null, ts);

    if (io) {
      io.to(deviceEntry.socketId).emit('command:incoming', {
        id: cmdId,
        device_token,
        command,
        params: params || null,
        timestamp: ts
      });
    }

    res.json([{ id: cmdId, success: true, delivered: true }]);
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

